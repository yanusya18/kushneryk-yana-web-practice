    {
      "name": "11. GET /api/items/1/availability?date= — зайняті години",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/items/1/availability?date={{tomorrow}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "items",
            "1",
            "availability"
          ],
          "query": [
            {
              "key": "date",
              "value": "{{tomorrow}}"
            }
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function fmt(d){ const p=n=>String(n).padStart(2,'0'); return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate()); }",
              "const d = new Date(); d.setDate(d.getDate() + 1); pm.collectionVariables.set('tomorrow', fmt(d));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Масив без персональних даних', function () { const j = pm.response.json(); pm.expect(j).to.be.an('array'); pm.expect(JSON.stringify(j)).to.not.include('customer'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12. POST /api/bookings — створити бронювання (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "bookings"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"workspaceId\": 2,\n  \"date\": \"{{bookDate}}\",\n  \"startTime\": \"10:00\",\n  \"endTime\": \"12:00\",\n  \"customerName\": \"Яна Тест\",\n  \"customerEmail\": \"yana@example.com\",\n  \"customerPhone\": \"+380501234567\",\n  \"consent\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function fmt(d){ const p=n=>String(n).padStart(2,'0'); return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate()); }",
              "// випадкова дата через 30–330 днів, щоб повторні запуски не конфліктували",
              "const d = new Date(); d.setDate(d.getDate() + 30 + Math.floor(Math.random() * 300)); pm.collectionVariables.set('bookDate', fmt(d));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Вартість рахує сервер: 2 год × 70 = 140', function () { pm.expect(pm.response.json().totalPrice).to.eql(140); });",
              "pm.test('Немає email і телефону у відповіді', function () { const j = pm.response.json(); pm.expect(j).to.not.have.property('customerEmail'); pm.expect(j).to.not.have.property('customerPhone'); });"
            ]
          }
        }
      ]
    },
