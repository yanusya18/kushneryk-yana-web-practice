# Скопіюйте у .env (cp .env.example .env). Файл .env не комітиться.
# Адреса API БЕЗ слеша в кінці. Змінні Vite мають починатися з VITE_
# Локально:  VITE_API_URL=http://localhost:3001
# Хостинг:   VITE_API_URL=https://ваш-api.onrender.com  (задається в налаштуваннях Vercel/Netlify)
VITE_API_URL=http://localhost:3001

# Адреса опублікованого сайту (для canonical). Заповнюється на хостингу, локально можна пропустити.
# VITE_SITE_URL=https://ваш-сайт.vercel.app
