# Скопіюйте цей файл у .env (cp .env.example .env) і за потреби змініть значення.
# Файл .env НЕ комітиться (він у .gitignore). Тут — лише безпечні приклади.

# Порт, на якому слухає сервер
PORT=3001

# Дозволені адреси клієнта для CORS (через кому, без слеша в кінці).
# На хостингу вкажіть адресу сайту, напр. https://my-site.vercel.app; для preview-деплоїв можна додати https://*.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Токен адміністратора для POST/PUT/DELETE /api/items. Локально можна залишити порожнім (захист вимкнено).
# На хостингу ОБОВ'ЯЗКОВО задайте довге випадкове значення — у налаштуваннях платформи, а не в репозиторії.
ADMIN_TOKEN=

# Файл «бази даних» (JSON); створюється автоматично з data/workspaces.seed.json
DATA_FILE=data/db.json

# Часовий пояс коворкінгу: за ним визначаються «сьогодні» та «зараз» під час бронювання
TIMEZONE=Europe/Kyiv

# development | production (у production не показуються деталі внутрішніх помилок)
NODE_ENV=development
